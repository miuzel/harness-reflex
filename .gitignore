node_modules/
dist/
.reflex/
.DS_Store
*.log
tmp/
dist-client/

# Generated at build time by scripts/embed-user-guide.mjs from USER_GUIDE.md
# and docs/USER_GUIDE.en.md, which stay the single source of truth.
packages/dsh-harness-reflex/src/client/guide.generated.ts

# release/: the tarballs, their checksums and the machine report are build
# outputs of `npm run release`; the human-readable notes stay trackable.
release/*.tgz
release/SHA256SUMS
release/release-report.json

# Scaffold written by `claude plugin validate`; types/.gitignore only covers
# the declaration files, so the shared tsconfig is ignored here explicitly.
packages/claude-reflex/.claude-plugin/types/tsconfig.json
packages/claude-reflex/tsconfig.json

# release/RELEASE-*.artifacts.md: machine-generated manifest, rebuilt by release-pack
release/*.artifacts.md
