{
  "name": "dsh-harness-reflex",
  "version": "0.1.0",
  "description": "DSH Host plugin exposing the harness-reflex System One decision runtime (choice, score, route, screen, gate) as in-process reflex_* tools; pruning, stagnation detection and turn closing run as automatic interventions, and the ledger is the /reflex-ledger command.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "client.js",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node ../../scripts/embed-user-guide.mjs && tsc -p tsconfig.client.json && node dist/client-bundle.js .",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-alpha.0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-commands": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-alpha.0 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-alpha.0 <0.2.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@types/node": "^22.20.4",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "engines": {
    "dsh": "<0.2.2"
  }
}
